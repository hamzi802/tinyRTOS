    {
      "id": "JblSa_cCx7HUEi_C5AV7N",
      "type": "text",
      "x": 719.967361680204,
      "y": 45.26402389602589,
      "width": 320.800048828125,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 2024416728,
      "version": 493,
      "versionNonce": 1832398760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775481704583,
      "link": null,
      "locked": false,
      "text": "runs with lowest priority so that when\ncall for context switch occurs while ISR\nruns, we don't return to the thread\nmode because while ISR running, jumping\nto Thread Mode would cause Usage\nFault.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "runs with lowest priority so that when call for context switch occurs while ISR runs, we don't return to the thread mode because while ISR running, jumping to Thread Mode would cause Usage Fault.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jSI49pa2cCnAws7NPQRLj",
