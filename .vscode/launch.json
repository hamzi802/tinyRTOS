{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32 (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",

      "servertype": "openocd",

      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/tinyRTOS.elf",

      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],

      "runToEntryPoint": "main",

      "device": "STM32F401",
      "interface": "swd",

      "postRestartCommands": [
        "monitor reset halt"
      ]
    }
  ]
}